{
  "name": "obs-e-com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A typed, tested and observable backend learning project",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run build",
    "dev:native": "node --env-file-if-exists=.env --import tsx --watch src/native/index.ts",
    "start:native": "node --env-file-if-exists=.env dist/native/index.js",
    "data:aggregate": "tsx src/aggregation/example.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "@types/express": "^5.0.3"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
